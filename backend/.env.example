# Parkash Book Depot Backend Environment Configuration
# Copy this file to .env and fill in with your actual values
# NEVER commit .env to version control

# ── Application Settings ──────────────────────────────────────────────────────
APP_NAME=Parkash Book Depot API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=False

# ── Security (CRITICAL - Change these in production) ──────────────────────────
# Generate a strong SECRET_KEY using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=3

# ── Database: MongoDB ─────────────────────────────────────────────────────────
# Local development:
MONGODB_URL=mongodb://localhost:27017
# Remote (MongoDB Atlas):
# MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=parkash_book_depot

# ── Database: PostgreSQL (for payments, Phase 6+) ──────────────────────────────
# Local development:
POSTGRES_URL=postgresql://postgres:password@localhost:5432/parkash_finance
# Production should use strong password and secured host

# ── CORS (Allowed Origins) ────────────────────────────────────────────────────
# Development: allow localhost on common ports
# Production: replace with your actual frontend domain
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Admin Account (for scripts/seed_admin.py) ─────────────────────────────────
# Run: ADMIN_NAME="Your Name" ADMIN_EMAIL="admin@example.com" ADMIN_PASSWORD="strong-password" python scripts/seed_admin.py
ADMIN_NAME=Vivek Kumar
ADMIN_EMAIL=admin@parkashbookdepot.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# ── Associate Accounts (for scripts/create_associates.py) ──────────────────────
# Run: ASSOCIATE_NAME="Name" ASSOCIATE_EMAIL="email@example.com" ASSOCIATE_PASSWORD="strong-password" python scripts/create_associates.py
ASSOCIATE_NAME=Associate Name
ASSOCIATE_EMAIL=associate@parkashbookdepot.com
ASSOCIATE_PASSWORD=change-this-to-a-strong-password

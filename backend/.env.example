# Parkash Book Depot — Environment Configuration
# Copy this to .env and fill in real values
# NEVER commit .env to version control

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Parkash Book Depot API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=False

# ── Security ──────────────────────────────────────────────────────────────────
# Generate SECRET_KEY:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-generated-value

# Generate PEPPER:      python -c "import secrets; print(secrets.token_hex(32))"
# ⚠️  Set once and never change — changing this locks out all existing users
PEPPER=replace-with-generated-value

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=3

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=parkash_book_depot

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma separated, exact domains only — no wildcards
# Production example: https://yourapp.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Request limits ────────────────────────────────────────────────────────────
MAX_REQUEST_SIZE_MB=5

# ── Admin seed script (scripts/seed_admin.py) ─────────────────────────────────
# Set these as environment variables before running, do not put real values here
ADMIN_NAME=Your Name Here
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=YourStr0ng!Password